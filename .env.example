# Harmonix360 Environment Variables
# Copy to .env and fill in real values before running.
#
# ---------------------------------------------------------------------------
# WHICH HOST/PORT DO I USE?
# ---------------------------------------------------------------------------
# This file is read by processes running on YOUR MACHINE — alembic, pytest,
# uvicorn, and the verify_*.py scripts — so its urls are HOST-side.
#
#   running on the host   ->  localhost:<published port>   (this file)
#   running in compose    ->  postgres:5432 / redis:6379   (compose network)
#
# Services defined in docker-compose.yml get their own DATABASE_URL and
# REDIS_URL from that file's `environment:` block and never read this one.
# Environment variables always win over this file, so nothing here can
# override a container's settings.
#
# The published host ports are whatever docker-compose.yml says, PLUS anything
# docker-compose.override.yml remaps. Check the override file before copying
# the defaults below — if another Postgres or Redis already owns 5432/6379 on
# your machine (a native Postgres service, another project's containers), the
# override republishes them and these urls must name the remapped ports. On the
# original dev machine that means 5544 and 6380.
# ---------------------------------------------------------------------------

# Database
# DATABASE_URL           -> app runtime role (harmonix360_app: cannot UPDATE/DELETE audit_logs)
# MIGRATION_DATABASE_URL -> migration owner role (superuser; alembic uses this)
#
# Database name: use a database owned by this repo's alembic history (e.g. harmonix360_core).
DATABASE_URL=postgresql+asyncpg://harmonix360_app:app_password@localhost:5544/harmonix360_core
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5544/harmonix360_core
HASHID_SALT=harmonix360-secret-salt-change-in-prod

# Redis
REDIS_URL=redis://localhost:6380/0

# Auth
JWT_SECRET=harmonix360-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# NOTE: read by config but currently unused — Harmonix360 issues access tokens only.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
PORT=8000

# AI Providers — real keys required for the AI decision path; the app starts
# and degrades to PENDING_REVIEW without them.
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional model overrides. Leave empty to use the defaults in
# app/core/config.py. Check the id against the provider's /v1/models before
# setting one: a retired id returns 404 model_not_found, which the router
# reads as a dead provider and every AI answer degrades to "unavailable".
GROQ_MODEL=
CEREBRAS_MODEL=
# OLLAMA_BASE_URL=http://ollama:11434  # Optional local Ollama

# MCP
MCP_AGENT_API_KEY=harmonix360-mcp-dev-key
MCP_SERVER_PORT=8100

# Observability — optional.
#
# Left unset, OpenTelemetry defaults to http://signoz-otel-collector:4318, which
# does not resolve outside compose and logs harmless export retries. For quiet
# local runs (pytest, verify_* scripts): OTEL_SDK_DISABLED=true
#
# SENTRY_DSN: setting this in .env makes Sentry live for HOST runs too.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# SENTRY_DSN=

# Phase 5: local MailHog. Leave SMTP_HOST unset: host defaults to localhost,
# Compose defaults to mailhog. Set an override only for another SMTP server.
# SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=payroll@peoplepay360.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Non-Linux host runs need WeasyPrint/Pango and these two DejaVu font files.
# PAYSLIP_FONT_DIR=/usr/share/fonts/truetype/dejavu
# Optional local Vite proxy override when port 8000 is already occupied.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8015
